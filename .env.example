# Copy this to .env and fill in real values. Never commit the real .env.

# Server auth (server/auth.py) - sign and verify session tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
NEUROLLA_JWT_SECRET=

# Broker credential encryption at rest (server/crypto_utils.py).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEUROLLA_ENCRYPTION_KEY=

# Google login verification (server/auth.py) - path to your Firebase
# service account JSON. Only needed by the /auth/google endpoint.
FIREBASE_CREDENTIALS_PATH=firebase-admin.json

# Telegram alerts (commander.py, core/risk_guard.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deriv broker (run_deriv.py)
# Note: mobile_app/main.py takes the Deriv API token directly in its
# UI instead - it doesn't read this env var.
DERIV_API_TOKEN=

# Optional: only set this if MT5 needs a specific terminal install
# rather than auto-detecting an already-running one (live/mt5_connector.py)
MT5_TERMINAL_PATH=
